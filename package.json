    "@iconify-json/emojione-monotone": "^1.2.1",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/fluent-emoji-high-contrast": "^1.2.6",
    "@vitejs/plugin-react": "^4.3.4",
    "emojibase-data": "^17.0.0",
